[Unit]
Description=Servora-Med BR5 backup worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=servora-med
Group=servora-med
WorkingDirectory=/opt/servora-med/current/server
EnvironmentFile=/etc/servora-med/servora-med.env
ExecStart=/usr/bin/node /opt/servora-med/current/server/dist/backup-worker.js
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/servora-med/br-workspaces

StandardOutput=journal
StandardError=journal
SyslogIdentifier=servora-med-backup-worker

[Install]
WantedBy=multi-user.target
