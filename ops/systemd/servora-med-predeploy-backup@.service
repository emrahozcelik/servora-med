[Unit]
Description=Servora-Med PostgreSQL pre-deploy backup for release %i
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=servora-med
Group=servora-med
EnvironmentFile=/etc/servora-med/servora-med-backup.env
# The root-installed launcher validates %i and derives the fixed SHA release
# path independently of the deploy caller.
ExecStart=/usr/local/libexec/servora-med/predeploy-backup-launcher %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/servora-med /var/log/servora-med

StandardOutput=journal
StandardError=journal
SyslogIdentifier=servora-med-predeploy-backup
