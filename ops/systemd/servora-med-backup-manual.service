[Unit]
Description=Servora-Med PostgreSQL backup (operator on-demand, oneshot)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=servora-med
Group=servora-med
EnvironmentFile=/etc/servora-med/servora-med-backup.env
# Explicit operator class. A manual run is a valid local restore point but must
# never satisfy the daily schedule heartbeat, so it cannot share a unit with the
# timer (DECISIONS.md -> OPS-004 item 7).
ExecStart=/opt/servora-med/current/ops/scripts/backup-postgres.sh --trigger=manual
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/servora-med /var/log/servora-med
StateDirectory=servora-med-backup
StateDirectoryMode=0700

StandardOutput=journal
StandardError=journal
SyslogIdentifier=servora-med-backup-manual
