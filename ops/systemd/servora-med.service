[Unit]
Description=Servora-Med API (Fastify)
After=network-online.target postgresql.service
Wants=network-online.target
# Active recovery keeps the durable barrier. Its one-start permit is volatile:
# reboot removes it, so a reserved but interrupted activation cannot auto-start.
ConditionPathExists=|!/var/lib/servora-med/deploy/activation.block
ConditionPathExists=|/run/servora-med-recovery/start.permit

[Service]
Type=simple
User=servora-med
Group=servora-med
WorkingDirectory=/opt/servora-med/current/server
Environment=NODE_ENV=production
EnvironmentFile=/etc/servora-med/servora-med.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=servora-med

[Install]
WantedBy=multi-user.target
