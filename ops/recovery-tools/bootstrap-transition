#!/usr/bin/env bash
# Separately provisioned root-only B1-02 installer/release issuer. Never delegate.
set -Eeuo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset NODE_OPTIONS NODE_PATH BASH_ENV ENV
fail() { printf '%s\n' "$1" >&2; exit 1; }
[[ "$EUID" -eq 0 && "$#" -ge 2 ]] || fail BOOTSTRAP_TRANSITION_ROOT_LINUX_REQUIRED
[[ "$1" == install || "$1" == release ]] || fail BOOTSTRAP_TRANSITION_ARGUMENTS_INVALID
readonly BASE=/usr/local/libexec/servora-med-bootstrap
readonly TOOL="$BASE/ops/recovery-tools/bootstrap-transition"
readonly HOST="$BASE/ops/recovery-tools/bootstrap-transition-host.mjs"
trusted_file() {
  local file="$1" mode="$2" directory
  [[ "$(realpath -e "$file")" == "$file" && -f "$file" && ! -L "$file" \
    && "$(stat -c '%U:%G:%a:%h' "$file")" == "root:root:$mode:1" ]] \
    || fail BOOTSTRAP_TRANSITION_TOOL_UNTRUSTED
  directory="$(dirname "$file")"
  while [[ "$directory" != / ]]; do
    [[ -d "$directory" && ! -L "$directory" && "$(stat -c %u "$directory")" == 0 \
      && $((8#$(stat -c %a "$directory") & 8#022)) -eq 0 ]] \
      || fail BOOTSTRAP_TRANSITION_TOOL_UNTRUSTED
    directory="$(dirname "$directory")"
  done
}
pin() {
  trusted_file "$1" 644
  [[ "$(sha256sum "$1" | awk '{print $1}')" == "$2" ]] \
    || fail BOOTSTRAP_TRANSITION_TOOL_UNTRUSTED
}
[[ "$(realpath -e "${BASH_SOURCE[0]}")" == "$TOOL" \
  && "$(stat -c '%U:%G:%a' "$BASE")" == root:root:750 ]] \
  || fail BOOTSTRAP_TRANSITION_TOOL_UNTRUSTED
trusted_file "$TOOL" 750
pin "$BASE/ops/recovery-tools/bootstrap-delegation-quarantine-host.mjs" 919cc7cb07aa499091c79e5a6f8c1893eb18d456976c2a90faa31d5e30ccfd41
pin "$BASE/ops/recovery-tools/bootstrap-delegation-quarantine.mjs" e78448ce582e516edabd91c655dd5b243689a1273fd3a1d05186dce7196dfd04
pin "$BASE/ops/recovery-tools/bootstrap-transition-host.mjs" 473c7025c448817fd79d2fb3aae22f93188784eeb32ced3949ca46fc66ed6fb4
