#!/usr/bin/env bash
# Root-only OPS-DEPLOY-002 one-time host transition entrypoint.
#
# Usage (as root, from a root-only directory holding this wrapper, its module
# and a staging directory with the three reviewed files):
#   ./normal-deploy-transition --check /root/ops-deploy-002/staging   # read-only rehearsal
#   ./normal-deploy-transition /root/ops-deploy-002/staging           # apply
#
# Not part of the release artifact and never added to deploy sudoers. Holds the
# stable host lock and refuses any pending recovery attempt before the module
# touches a file. Rerunning after an interruption resumes the same re-seal.
set -Eeuo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset NODE_OPTIONS NODE_PATH BASH_ENV ENV
fail(){ printf '%s\n' "$1" >&2; exit 1; }

[[ "$EUID" -eq 0 ]] || fail OPS_DEPLOY_002_ROOT_REQUIRED
[[ ( "$#" -eq 1 && "$1" == /* ) || ( "$#" -eq 2 && "$1" == --check && "$2" == /* ) ]] \
  || fail OPS_DEPLOY_002_ARGUMENTS_INVALID

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly MODULE="$SCRIPT_DIR/normal-deploy-transition.mjs"
# Filled from the reviewed module bytes. A mismatch is a STOP.
readonly MODULE_SHA256=215d27b09bde9fe978d2a4ff301d8b9b5888ca2438bedbb88158d3b45c56ef61
readonly LIBRARY=/usr/local/libexec/servora-med/host-operation-lock.sh

trusted_file(){
  local path="$1" mode="$2" directory
  [[ "$(realpath -e "$path")" == "$path" && -f "$path" && ! -L "$path" \
    && "$(stat -c '%U:%G:%a:%h' "$path")" == "root:root:$mode:1" ]] \
      || fail OPS_DEPLOY_002_TOOL_UNTRUSTED
  directory="$(dirname "$path")"
  while [[ "$directory" != / ]]; do
    [[ -d "$directory" && ! -L "$directory" && "$(stat -c %u "$directory")" == 0 \
      && $((8#$(stat -c %a "$directory") & 8#022)) -eq 0 ]] \
        || fail OPS_DEPLOY_002_TOOL_UNTRUSTED
    directory="$(dirname "$directory")"
  done
}

trusted_file "$MODULE" 644
[[ "$(sha256sum "$MODULE" | awk '{print $1}')" == "$MODULE_SHA256" ]] || fail OPS_DEPLOY_002_TOOL_UNTRUSTED
trusted_file "$LIBRARY" 644
[[ "$(sha256sum "$LIBRARY" | awk '{print $1}')" == \
  a5564b6e82256fed8260a86d8c3d582c009c6fac4f2ad4216a61e566bb5f500e ]] || fail OPS_DEPLOY_002_TOOL_UNTRUSTED
# The library is a runtime, hash-pinned path; shellcheck cannot follow it.
# shellcheck disable=SC1090,SC1091
source "$LIBRARY"
servora_acquire_host_lock
servora_assert_no_pending_attempt

/usr/bin/env -i PATH="$PATH" LANG=C LC_ALL=C /usr/bin/node --no-addons "$MODULE" "$@"
