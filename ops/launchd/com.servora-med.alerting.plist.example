<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Servora-Med operator alerting — LaunchDaemon example (non-root, NOT installed).
  Install as /Library/LaunchDaemons/com.servora-med.alerting.plist (root:wheel, mode 0644).
  Wrapper: ops/launchd/run-alerting.sh.example → /usr/local/libexec/servora-med/run-alerting.sh
  Runs as dedicated service user servora-med (never root). Every 5 minutes via StartInterval.
  Webhook credentials live only in the private env file sourced by the wrapper.
  Activation requires separate operator authorization — do not bootstrap this file.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.servora-med.alerting</string>
	<key>UserName</key>
	<string>servora-med</string>
	<key>GroupName</key>
	<string>servora-med</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/servora-med/run-alerting.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/usr/local/var/log/servora-med/alerting.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/servora-med/alerting.stderr.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
