# Servora-Med operator alerting — private operator environment example.
#
# Install as a private operator-owned file (never commit real values):
#   macOS: /etc/servora-med/servora-med-alerting.env (root:wheel, mode 0600)
#   Linux: /etc/servora-med/servora-med-alerting.env (root:servora-med, mode 0600)
#
# The monitor is DEFAULT DISABLED. Set SERVORA_ALERTING_ENABLED=true only
# during an explicitly authorized host activation.

SERVORA_ALERTING_ENABLED=false

# Vendor-neutral HTTPS JSON webhook (loopback plain http allowed for testing).
SERVORA_ALERT_WEBHOOK_URL=

# Application health endpoint — do not change the app contract.
SERVORA_ALERT_HEALTH_URL=http://127.0.0.1:3000/api/health

# Read-only backup directory produced by ops/scripts/backup-postgres.sh.
SERVORA_ALERT_BACKUP_DIR=

# Maximum accepted age of the latest valid canonical backup.
SERVORA_ALERT_BACKUP_MAX_AGE_HOURS=26

# Filesystem to check for free space.
SERVORA_ALERT_DISK_PATH=/

# Minimum free percent before a disk warning.
SERVORA_ALERT_DISK_MIN_FREE_PERCENT=15

# Consecutive failures before an alert is sent.
SERVORA_ALERT_FAILURE_THRESHOLD=3

# Minimum interval between reminder webhooks while a check stays failing.
SERVORA_ALERT_COOLDOWN_MINUTES=60

# Per-request timeout for health probe and webhook delivery.
SERVORA_ALERT_TIMEOUT_MS=5000

# Operator-owned state directory (lock + deduplication state, mode 0700).
SERVORA_ALERT_STATE_DIR=

# Safe payload labels.
SERVORA_ALERT_ENVIRONMENT=local
SERVORA_ALERT_INSTANCE_LABEL=servora-med
