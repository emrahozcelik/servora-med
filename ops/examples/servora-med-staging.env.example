# Placeholder-only staging environment example — Servora-Med.
# Install as the staging environment file (root:servora-med, mode 0640).
# Never commit real secrets. Replace every <...> placeholder at install time.
# This file is documentation; it is not applied by any automation.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Single exact HTTPS origin for the staging FQDN (no path).
# Operator-provided HTTPS origin; unresolved until ingress provisioning.
CORS_ORIGIN=https://<STAGING_FQDN>

# Staging database only — never servora_med, servora_med_test, or production.
# Replace <STAGING_DB_PASSWORD> with a URL-safe secret (canonical generator:
# openssl rand -hex 32) or a percent-encoded password. Never put it on argv.
DATABASE_URL=postgresql://servora:<STAGING_DB_PASSWORD>@127.0.0.1:5432/servora_med_staging

SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# Required. loopback | 127.0.0.1 | ::1
TRUSTED_PROXY=loopback

# Required. Exact schema_migrations.version for readiness; must equal the
# latest canonical migration identifier in the deployed release.
HEALTH_SCHEMA_VERSION=023_staff_confidential_notes

# Feature flags — initial staging contract keeps these disabled.
OVERVIEW_DASHBOARD_ENABLED=true
CALENDAR_ENABLED=false
CALENDAR_REMINDER_LEAD_MINUTES=30
MESSAGING_ENABLED=false
WEB_PUSH_ENABLED=false
ACTION_SCOPED_GEOLOCATION_ENABLED=false

# Not required while WEB_PUSH_ENABLED=false. No real keys in this file.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Not required while ACTION_SCOPED_GEOLOCATION_ENABLED=false.
REVERSE_GEOCODER_PROVIDER=
GOOGLE_GEOCODING_API_KEY=

# Optional support metadata (no personal real-world contact required).
# Quoted: this file is shell-sourced by the macOS API wrapper.
SUPPORT_DISPLAY_LABEL="Sistem yöneticiniz"
SUPPORT_EMAIL=
SUPPORT_HELP_URL=
