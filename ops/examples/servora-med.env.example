# Install as /etc/servora-med/servora-med.env (root:servora-med, mode 0640).
# Never commit real secrets.
# Canonical pilot DB auth: password-bearing DATABASE_URL (not peer trust, not PGPASSFILE).
# Password must be URL-safe (preferred: openssl rand -hex 32) or percent-encoded in the URL.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Single exact https origin for the public FQDN (no path).
CORS_ORIGIN=https://app.example.com

# Application role + password. Replace <APP_DB_PASSWORD> with a URL-safe secret
# (canonical generator: openssl rand -hex 32) or a percent-encoded password.
# Readable only by root and group servora-med (mode 0640). Never put the password on argv.
DATABASE_URL=postgresql://servora:<APP_DB_PASSWORD>@127.0.0.1:5432/servora_med

SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# Required in production. loopback | 127.0.0.1 | ::1
TRUSTED_PROXY=loopback

# Required in production. Exact schema_migrations.version for readiness.
# Must equal the latest canonical migration identifier in the deployed release.
HEALTH_SCHEMA_VERSION=034_demo_data_foundation

# Keep false until the governed geolocation production-enablement gates are approved.
ACTION_SCOPED_GEOLOCATION_ENABLED=false

# Backup & Recovery V1 domain capability (BR1 foundation: metadata + admin API
# only). Keep false until the BR2–BR5 execution slices and R2/age secrets are
# provisioned; the app starts fine without them while this is false.
BACKUP_ENABLED=false

# BR2 local backup engine paths. Optional: empty means "not configured" and is
# valid — the app must keep starting without BR3/BR4 secrets. BACKUP_TEMP_ROOT
# must live outside the application/web roots (never inside the repo).
BACKUP_TEMP_ROOT=/var/backups/servora-med/br-workspaces
# Set only when FULL_DATA backups with persistent Servora files are in use.
BACKUP_FILES_ROOT=

# BR3 backup encryption recipient. PUBLIC value (not a secret): must be a
# native age post-quantum hybrid recipient (age1pq1…, requires age >= 1.3).
# Generate offline: `age-keygen -pq -o identity` then `age-keygen -y identity`;
# keep the private identity OFF this server (operator custody only — see
# docs/operations/backup-recovery/architecture.md §10). Empty = not
# configured, which stays valid until the BR5 worker is enabled. There is no
# supported private-identity setting on purpose.
BACKUP_ENCRYPTION_RECIPIENT=

# BR4 remote storage (Cloudflare R2, the only approved provider). All values
# optional: empty = not configured, which stays valid until the BR5 worker is
# enabled. The token MUST be bucket-scoped Object Read & Write only — never a
# Cloudflare admin/bucket-management credential (the runtime never configures
# Bucket Lock, lifecycle, or bucket settings). Long-lived R2 tokens are
# BUCKET-scoped, not prefix-scoped. BR4 completed backup uploads are atomic
# conditional single PUT only; objects above 5 GiB - 5 MiB (5,363,466,240
# bytes) fail closed until multipart no-overwrite is reconciled. Values below
# are obviously fake placeholders;
# never commit real credentials.
BACKUP_INSTANCE_ID=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
# Display-only alias for admin surfaces; safe, non-secret.
BACKUP_R2_BUCKET_ALIAS=

# BR5 worker remains disabled until the production cutover gate is approved.
# This is a separate process; the API does not claim backup runs.
BACKUP_WORKER_ENABLED=false
BACKUP_WORKER_LEASE_MS=60000
BACKUP_WORKER_HEARTBEAT_INTERVAL_MS=15000
BACKUP_WORKER_POLL_INTERVAL_MS=5000

# Keep false until Phase U2 Ready/merge and production enablement are separately approved.
CALENDAR_ENABLED=false
CALENDAR_REMINDER_LEAD_MINUTES=30

# Keep false until the Phase R production enablement checklist is approved.
# Install guidance is independent and remains available while Web Push is disabled.
WEB_PUSH_ENABLED=false
# Required only when WEB_PUSH_ENABLED=true. Generate once outside Git and keep
# the private key only in this root-owned environment file.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
