# BR7 operator CLI only. Keep this file outside the application repository
# and source it with a restrictive umask. Never put the age private key here.

# Canonical installation identity and read-only R2 credentials.
BACKUP_INSTANCE_ID=replace-with-opaque-instance-id
BACKUP_R2_ACCOUNT_ID=00000000000000000000000000000000
BACKUP_R2_ACCESS_KEY_ID=replace-with-read-only-access-key
BACKUP_R2_SECRET_ACCESS_KEY=replace-with-secret-from-operator-vault
BACKUP_R2_BUCKET=replace-with-disposable-or-production-backup-bucket

# Administrative connection to a maintenance database. This is not silently
# taken from DATABASE_URL; target DB name is still required on the command.
RESTORE_TARGET_DATABASE_URL=postgresql://restore_operator:password@127.0.0.1:5432/postgres

# Optional normal-installation control DB for REHEARSAL mode. Omit in explicit
# DISASTER_RECOVERY mode when the source metadata DB is unavailable.
RESTORE_CONTROL_DATABASE_URL=postgresql://restore_operator:password@127.0.0.1:5432/servora_med
PRODUCTION_DATABASE_URL=postgresql://servora_app:password@127.0.0.1:5432/servora_med

# Operator-held identity file; permissions must be 0600 or stricter.
SERVORA_BACKUP_AGE_IDENTITY=/secure/operator/servora-backup-identity.txt

# Optional restrictive paths.
# RESTORE_WORKSPACE_ROOT=/var/lib/servora-med/restore-workspaces
# RESTORE_EVIDENCE_DIR=/var/lib/servora-med/restore-evidence
# BACKUP_FILES_ROOT=/var/lib/servora-med/files
