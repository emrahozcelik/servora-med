+  border-bottom: 1px solid var(--rule);
+}
+.own-staff-profile .profile-facts > div { padding: 0; border: 0; min-width: 0; }
+.own-staff-profile .profile-facts dd { overflow-wrap: anywhere; font-weight: 600; }
+.own-staff-profile #counter-title { margin: 0; font-size: 1.125rem; }
+.own-staff-profile .counter-grid {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
+  gap: 0;
+  border-block: 1px solid var(--rule);
+}
+.own-staff-profile .counter-grid > div { min-width: 0; border: 0; border-radius: 0; }
+.own-staff-profile .counter-grid dt { font-size: 0.875rem; }
+.own-staff-profile .counter-grid dd { font-variant-numeric: tabular-nums; }
+.own-staff-profile .staff-job-history { margin-top: 1.5rem; }
+.customer-edit-disclosure { margin-top: 1.25rem; }
+.customer-edit-disclosure > summary {
+  display: list-item;
+  width: fit-content;
+  min-height: var(--control-height);
+  padding-block: 0.65rem;
+  color: var(--accent);
+  font-weight: 650;
+  cursor: pointer;
+}
+.customer-edit-disclosure > summary:hover { text-decoration: underline; }
+.customer-detail .operational-summary { margin-top: 1.25rem; }
+.customer-detail .operational-summary .record-facts > div { min-width: 0; }
+.customer-detail .operational-summary dd { overflow-wrap: anywhere; }
+.customer-detail .operational-summary dd p { margin: 0.35rem 0 0; color: var(--muted); font-size: 0.875rem; }
+.product-row-commands .product-delete-action { color: var(--muted); background: transparent; }
+.job-list-card .job-row-relations dd { color: var(--ink); font-weight: 600; }
+.job-list-card .compact-workflow:not(.compact-workflow--attention) { font-weight: 400; }
+.job-list-card .compact-workflow:not(.compact-workflow--attention) p { color: var(--muted); font-weight: 400; }
+.job-list-card .compact-workflow { margin-top: 0.5rem; }
+.staff-report-method .report-section-hint { max-width: 75ch; }
+@media (max-width: 40rem) {
+  .own-staff-profile .profile-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .own-staff-profile .counter-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr)); }
+}
+
+.customer-list-card .customer-identity,
+.customer-list-card .customer-facts > div { min-width: 0; overflow-wrap: anywhere; }
+.customer-detail .record-facts > div { min-width: 0; }
+.customer-detail .record-facts dd { overflow-wrap: anywhere; }
