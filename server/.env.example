NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://servora:servora@localhost:5432/servora_med
# Canonical server tests require an EXPLICIT test database. There is no
# DATABASE_URL fallback and no silent database-name rewrite, so two worktrees
# cannot silently share one persistent database.
# Local runs must use an explicitly isolated name and a password-bearing URL.
# CI supplies its own ephemeral service-owned servora_med_test.
# TEST_DATABASE_URL=postgresql://<test-user>:<test-password>@127.0.0.1:5432/servora_med_test_<suffix>
LOG_LEVEL=info
CORS_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
# Production: required. Allowed: loopback | 127.0.0.1 | ::1
TRUSTED_PROXY=loopback
# Production: required exact schema_migrations.version for readiness
# Development/test: optional
HEALTH_SCHEMA_VERSION=
# Fail-closed Phase Q gate. Keep false until disclosure, retention, and provider approval.
ACTION_SCOPED_GEOLOCATION_ENABLED=false
# Required only when ACTION_SCOPED_GEOLOCATION_ENABLED=true.
REVERSE_GEOCODER_PROVIDER=google
GOOGLE_GEOCODING_API_KEY=
REVERSE_GEOCODER_TIMEOUT_MS=2000
GEOCODING_USER_DAILY_LIMIT=15
GEOCODING_ORG_DAILY_LIMIT=250
GEOCODING_GLOBAL_MONTHLY_LIMIT=8000
# Fail-closed Phase U2 gate. Reminder worker does not start while disabled.
CALENDAR_ENABLED=false
CALENDAR_REMINDER_LEAD_MINUTES=30
# Fail-closed Phase R gate. Install guidance remains available while disabled.
WEB_PUSH_ENABLED=false
# Required only when WEB_PUSH_ENABLED=true. Generate one VAPID pair outside Git.
# Keep the private key only in the root-owned production environment file.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# OVR-4 LATE_SUBMISSION reminder/escalation worker. Opt-in: while disabled the
# process starts no background notifier. Thresholds are minutes after the
# immutable breach instant; management escalation must be >= the staff nudge.
OVERDUE_REMINDER_ENABLED=false
OVERDUE_REMINDER_STAFF_MINUTES=15
OVERDUE_REMINDER_MANAGEMENT_MINUTES=60
OVERDUE_REMINDER_POLL_INTERVAL_MS=60000
OVERDUE_REMINDER_BATCH_SIZE=20

# Production notes:
# - CORS_ORIGIN must be a single https origin (no path)
# - HOST must be 127.0.0.1 or ::1
# - HEALTH_SCHEMA_VERSION is required and must match the latest migration (currently 045_calendar_request_hash)
# - Secrets come from /etc/servora-med/servora-med.env, not a repo .env
# - Never commit generated VAPID keys

# One-time production/admin bootstrap. Never commit real values.
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Development seed only. Creates admin/manager/staff demo users.
DEV_SEED_ORGANIZATION_NAME=Servora Med Demo
DEV_SEED_PASSWORD=
