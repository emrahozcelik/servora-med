{
  "name": "servora-med-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servora-Med React web application",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "acceptance:duplicate-review": "node tests/duplicate-review-browser-regression.mjs",
    "acceptance:r2b-demo-data": "node scripts/r2b-demo-data-acceptance.mjs",
    "acceptance:r3b-invalidation": "node scripts/r3b-jobcard-invalidation-acceptance.mjs",
    "acceptance:r4b-offboarding": "node scripts/r4b-staff-offboarding-acceptance.mjs",
    "smoke:responsive": "node scripts/responsive-smoke.mjs && node scripts/calendar-responsive-smoke.mjs && node scripts/jobs-control-surface-geometry.mjs && node scripts/shell-brand-geometry.mjs && node scripts/weekly-report-question-geometry.mjs && node scripts/weekly-report-detail-layout.mjs && node scripts/job-detail-spacing-geometry.mjs",
    "smoke:weekly-report": "node scripts/weekly-report-question-geometry.mjs && node scripts/weekly-report-detail-layout.mjs",
    "smoke:shell": "node scripts/shell-brand-geometry.mjs",
    "smoke:production-dist": "node scripts/production-dist-smoke.mjs",
    "bundle:report": "node scripts/report-bundle-sizes.mjs",
    "bundle:check": "BUNDLE_ENFORCE=1 node scripts/report-bundle-sizes.mjs",
    "audit:high": "node scripts/audit-high-policy.mjs"
  },
  "dependencies": {
    "antd": "6.5.1",
    "dayjs": "1.11.21",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "28.1.0",
    "playwright": "^1.55.1",
    "typescript": "5.9.3",
    "vite": "8.1.6",
    "vitest": "4.1.11"
  }
}
